using System;

namespace VehicleHierarchy
{
    public class Vehicle
    {
        public string Brand { get; set; }
        public int Year { get; set; }

        public Vehicle(string brand, int year)
        {
            Brand = brand;
            Year = year;
        }

        public void Start()
        {
            Console.WriteLine($"The vehicle {Brand} ({Year}) is starting.");
        }
    }

    public class Car : Vehicle
    {
        public int NumberOfDoors { get; set; }

        public Car(string brand, int year, int numberOfDoors) : base(brand, year)
        {
            NumberOfDoors = numberOfDoors;
        }
    }

    public class Bus : Vehicle
    {
        public int Capacity { get; set; }

        public Bus(string brand, int year, int capacity) : base(brand, year)
        {
            Capacity = capacity;
        }
    }

    public class Motorcycle : Vehicle
    {
        public bool HasSidecar { get; set; }

        public Motorcycle(string brand, int year, bool hasSidecar) : base(brand, year)
        {
            HasSidecar = hasSidecar;
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            Car myCar = new Car("Toyota Hilux", 2023, 4);
            Bus myBus = new Bus("Toyota Coaster", 2020, 30);
            Motorcycle myMotorcycle = new Motorcycle("Potian", 2022, false);

            myCar.Start();
            myBus.Start();
            myMotorcycle.Start();
        }
    }
}
